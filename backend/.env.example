NODE_ENV=development
PORT=4000
# General server configuration lives here. Database credentials belong in
# atlas-credentials.env, which is ignored by Git.
CLIENT_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-local-secret
OCR_SPACE_API_KEY=
# Recipe AI uses OPENAI_API_KEY when set, otherwise OCR_SPACE_API_KEY (the key already used in this repo).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# MongoDB Atlas variables (normally kept in atlas-credentials.env instead).
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=mongodb+srv://<cluster-host>/openbasket?retryWrites=true&w=majority

# Add these only when the payments workstream begins. Never commit actual values.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
