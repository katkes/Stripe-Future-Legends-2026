NODE_ENV=development
PORT=4000
# General server configuration lives here. Database credentials belong in
# atlas-credentials.env, which is ignored by Git.
CLIENT_ORIGIN=http://localhost:3000

# MongoDB Atlas variables (normally kept in atlas-credentials.env instead).
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=mongodb+srv://<cluster-host>/openbasket?retryWrites=true&w=majority

# Add these only when the payments workstream begins. Never commit actual values.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
